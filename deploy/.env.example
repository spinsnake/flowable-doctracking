# Copy to a private deploy/.env. Never commit populated values.
# Dev: docker compose --env-file deploy/.env -f compose.yaml -f compose.dev.yaml up --build
DATABASE_PASSWORD=
APP_URL=http://localhost:8080
WEB_PORT=8080
SPRING_PROFILES_ACTIVE=prod
APP_POLICY_CONFIRMED=false

# Callback: APP_URL + /api/v1/auth/google/callback, exact match in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=mfu.ac.th
BOOTSTRAP_ADMIN_EMAIL=
SESSION_SECURE=true
SESSION_TTL_MINUTES=30

# Development defaults; approve P0 policies before setting APP_POLICY_CONFIRMED=true.
DEFAULT_TRACKING_MODE=MODEL_B
RESERVATION_TTL_SECONDS=600
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_TIMER_ENABLED=true

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
IT_CONTACT=
# Handoff contacts, not application settings.
SMTP_FAILED_JOB_OWNER_EMAIL=
STAGING_TEST_MFU_EMAIL=

EVIDENCE_BACKEND=s3
S3_BUCKET=
# Empty for AWS S3; HTTPS origin for another S3-compatible service.
S3_ENDPOINT=
AWS_REGION=ap-southeast-1
# Prefer workload credentials on managed infrastructure.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
