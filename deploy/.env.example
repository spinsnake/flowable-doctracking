# P0 handoff template only. Empty values are NOT ready for staging.
# Copy into a private environment/secret store during P1 deployment setup.
# Do not commit the populated file or copy another application's OAuth client blindly.

# Public HTTPS origin for this Flowable application; no trailing slash.
APP_URL=
# Must exactly match APP_URL + /api/v1/auth/google/callback and Google Console.
GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=mfu.ac.th
# A named, approved individual MFU account; no default shared admin identity.
BOOTSTRAP_ADMIN_EMAIL=

# Organization-authorized mail relay and sender, independent of Google login scopes.
SMTP_HOST=
SMTP_PORT=
# STARTTLS or TLS, according to the relay administrator's configuration.
SMTP_SECURITY=
# true/false; credentials are required only when the relay uses SMTP authentication.
SMTP_AUTH=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FAILED_JOB_OWNER_EMAIL=
STAGING_TEST_MFU_EMAIL=

# Application session secret; provision a random secret in the target environment.
SESSION_SECRET=
